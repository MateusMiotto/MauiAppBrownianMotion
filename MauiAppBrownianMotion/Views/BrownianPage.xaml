<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiAppBrownianMotion.Pages.BrownianPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:MauiAppBrownianMotion.Behaviors"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:MauiAppBrownianMotion.ViewModels"
    Title="Brownian Motion"
    x:DataType="vm:BrownianViewModel">

    <ContentPage.Resources>
        <Style x:Key="InputLabelStyle" TargetType="Label">
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="NumericEntryStyle" TargetType="Entry">
            <Setter Property="Keyboard" Value="Numeric" />
            <Setter Property="IsReadOnly" Value="{Binding CanCancelar}" />
        </Style>
        <Style
            x:Key="NarrowEntryStyle"
            BasedOn="{StaticResource NumericEntryStyle}"
            TargetType="Entry">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="FieldContainerVertical" TargetType="VerticalStackLayout">
            <Setter Property="Spacing" Value="4" />
            <Setter Property="Margin" Value="0,0,24,12" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="LayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ChartColumn" Width="*" />
            <ColumnDefinition x:Name="PanelColumn" Width="340" />
        </Grid.ColumnDefinitions>

        <!--  Gráfico  -->
        <GraphicsView
            x:Name="Chart"
            Grid.Row="0"
            Grid.Column="0"
            Drawable="{Binding Source={x:Reference Chart}, Path=BindingContext, Mode=OneWay}" />

        <!--  Painel (modo Wide)  -->
        <ContentView
            x:Name="WidePanel"
            Grid.Row="0"
            Grid.Column="1"
            Padding="16,16,16,24"
            IsVisible="True">
            <VerticalStackLayout Spacing="12">
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="8">
                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource InputLabelStyle}"
                        Text="Preço inicial:" />
                    <Entry
                        x:Name="PrecoInicialEntry"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource NumericEntryStyle}"
                        Text="{Binding PrecoInicialInput}">
                        <Entry.Behaviors>
                            <behaviors:NumericEntryBehavior />
                        </Entry.Behaviors>
                    </Entry>
                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource InputLabelStyle}"
                        Text="{Binding Source={RelativeSource AncestorType={x:Type vm:BrownianViewModel}}, Path=PeriodicidadeSufixo, StringFormat='Volatilidade (% {0}):'}" />
                    <Entry
                        x:Name="VolatilidadeEntry"
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource NumericEntryStyle}"
                        Text="{Binding VolatilidadePercentInput}">
                        <Entry.Behaviors>
                            <behaviors:NumericEntryBehavior />
                        </Entry.Behaviors>
                    </Entry>
                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource InputLabelStyle}"
                        Text="{Binding Source={RelativeSource AncestorType={x:Type vm:BrownianViewModel}}, Path=PeriodicidadeSufixo, StringFormat='Retorno (% {0}):'}" />
                    <Entry
                        x:Name="RetornoEntry"
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource NumericEntryStyle}"
                        Text="{Binding RetornoPercentInput}">
                        <Entry.Behaviors>
                            <behaviors:NumericEntryBehavior />
                        </Entry.Behaviors>
                    </Entry>
                    <Label
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource InputLabelStyle}"
                        Text="Tempo (dias):" />
                    <Entry
                        x:Name="TempoDiasEntry"
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource NumericEntryStyle}"
                        Text="{Binding TempoDiasInput}">
                        <Entry.Behaviors>
                            <behaviors:NumericEntryBehavior />
                        </Entry.Behaviors>
                    </Entry>
                    <Label
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource InputLabelStyle}"
                        Text="Nº simulações:" />
                    <Entry
                        x:Name="NumeroSimulacoesEntry"
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource NumericEntryStyle}"
                        Text="{Binding NumeroSimulacoesInput}">
                        <Entry.Behaviors>
                            <behaviors:NumericEntryBehavior />
                        </Entry.Behaviors>
                    </Entry>
                    <Label
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource InputLabelStyle}"
                        Text="Usar valores mensais" />
                    <Switch
                        Grid.Row="5"
                        Grid.Column="1"
                        HorizontalOptions="Start"
                        IsToggled="{Binding UsarPeriodicidadeMensal}" />
                    <HorizontalStackLayout
                        Grid.Row="6"
                        Grid.ColumnSpan="2"
                        Spacing="8">
                        <ActivityIndicator IsRunning="{Binding IsProcessing}" IsVisible="{Binding IsProcessing}" />
                        <Label
                            FontSize="11"
                            Text="{Binding ProcessingTime, StringFormat='Tempo de Processamento: {0}'}"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Grid>
                <HorizontalStackLayout Spacing="8">
                    <Button
                        Command="{Binding GerarSimulacaoCommand}"
                        IsEnabled="{Binding CanGerarSimulacao}"
                        IsVisible="{Binding MostrarBotaoGerar}"
                        Text="Gerar" />
                    <Button
                        Background="Red"
                        Command="{Binding CancelarCommand}"
                        IsEnabled="{Binding CanCancelar}"
                        Text="Cancelar" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ContentView>

        <!--  Painel (modo Narrow) - abaixo do gráfico  -->
        <ContentView
            x:Name="NarrowPanel"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Padding="12,8"
            IsVisible="False">
            <VerticalStackLayout Spacing="8">
                <FlexLayout
                    AlignContent="Start"
                    AlignItems="Start"
                    Direction="Row"
                    JustifyContent="Start"
                    Wrap="Wrap">
                    <VerticalStackLayout Style="{StaticResource FieldContainerVertical}" WidthRequest="140">
                        <Label FontSize="11" Text="Preço" />
                        <Entry
                            x:Name="PrecoInicialEntryN"
                            Style="{StaticResource NarrowEntryStyle}"
                            Text="{Binding PrecoInicialInput}">
                            <Entry.Behaviors>
                                <behaviors:NumericEntryBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FieldContainerVertical}" WidthRequest="160">
                        <Label FontSize="11" Text="{Binding PeriodicidadeSufixo, StringFormat='Vol (% {0})'}" />
                        <Entry
                            x:Name="VolatilidadeEntryN"
                            Style="{StaticResource NarrowEntryStyle}"
                            Text="{Binding VolatilidadePercentInput}">
                            <Entry.Behaviors>
                                <behaviors:NumericEntryBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FieldContainerVertical}" WidthRequest="150">
                        <Label FontSize="11" Text="{Binding PeriodicidadeSufixo, StringFormat='Ret (% {0})'}" />
                        <Entry
                            x:Name="RetornoEntryN"
                            Style="{StaticResource NarrowEntryStyle}"
                            Text="{Binding RetornoPercentInput}">
                            <Entry.Behaviors>
                                <behaviors:NumericEntryBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FieldContainerVertical}" WidthRequest="120">
                        <Label FontSize="11" Text="Dias" />
                        <Entry
                            x:Name="TempoDiasEntryN"
                            Style="{StaticResource NarrowEntryStyle}"
                            Text="{Binding TempoDiasInput}">
                            <Entry.Behaviors>
                                <behaviors:NumericEntryBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FieldContainerVertical}" WidthRequest="140">
                        <Label FontSize="11" Text="Simulações" />
                        <Entry
                            x:Name="NumeroSimulacoesEntryN"
                            Style="{StaticResource NarrowEntryStyle}"
                            Text="{Binding NumeroSimulacoesInput}">
                            <Entry.Behaviors>
                                <behaviors:NumericEntryBehavior />
                            </Entry.Behaviors>
                        </Entry>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource FieldContainerVertical}" WidthRequest="140">
                        <Label FontSize="11" Text="Mensal" />
                        <Switch IsToggled="{Binding UsarPeriodicidadeMensal}" />
                    </VerticalStackLayout>
                </FlexLayout>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Start">
                    <ActivityIndicator IsRunning="{Binding IsProcessing}" IsVisible="{Binding IsProcessing}" />
                    <Label
                        FontSize="11"
                        Text="{Binding ProcessingTime, StringFormat='Tempo de Processamento: {0}'}"
                        VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <Button
                        Command="{Binding GerarSimulacaoCommand}"
                        IsEnabled="{Binding CanGerarSimulacao}"
                        IsVisible="{Binding MostrarBotaoGerar}"
                        Text="Gerar" />
                    <Button
                        Background="Red"
                        Command="{Binding CancelarCommand}"
                        IsEnabled="{Binding CanCancelar, Converter={toolkit:InvertedBoolConverter}}"
                        Text="Cancelar" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ContentView>

        <!--  Visual States  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter TargetName="PanelColumn" Property="Width" Value="0" />
                        <Setter TargetName="Chart" Property="Grid.ColumnSpan" Value="2" />
                        <Setter TargetName="WidePanel" Property="IsVisible" Value="False" />
                        <Setter TargetName="NarrowPanel" Property="IsVisible" Value="True" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter TargetName="PanelColumn" Property="Width" Value="340" />
                        <Setter TargetName="Chart" Property="Grid.ColumnSpan" Value="1" />
                        <Setter TargetName="WidePanel" Property="IsVisible" Value="True" />
                        <Setter TargetName="NarrowPanel" Property="IsVisible" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</ContentPage>